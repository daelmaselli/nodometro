# Destinazione Prometheus Remote Write, raggiungibile anche dalla rete bridge.
# localhost nei collector non indica l'host.
VICTORIAMETRICS_URL=http://victoriametrics.example:8428/api/v1/write

# GID del socket Docker SUL NODO LOCALE (necessario per i profili Docker):
#   stat -c '%g' /var/run/docker.sock
# Non copiare il numero da un altro nodo. Senza profili Docker puo restare vuoto.
DOCKER_GID=

# Profili disponibili: docker, image-check, docker-prune, zfs.
# Vuoto = sole metriche standard; zfs richiede OpenZFS e /dev/zfs sul nodo.
COMPOSE_PROFILES=docker,image-check,docker-prune

# Directory degli stack Compose da leggere per verificare le immagini.
COMPOSE_ROOT=/root/docker

# Telegraf principale E collector Docker: durate come 30s, 60s, 1m.
# Raccolta: frequenza dei campioni standard, dell'inventario Docker e della
# lettura degli snapshot .prom. Allungarla riduce i campioni inviati al server.
TELEGRAF_INTERVAL=30s
# Invio: frequenza di svuotamento del buffer verso VictoriaMetrics.
# Allungarlo raggruppa i campioni ma non ne riduce il numero; batch grandi
# possono comunque richiedere piu richieste HTTP.
TELEGRAF_FLUSH_INTERVAL=30s

# Override facoltativi per il solo servizio docker. Se omessi/vuoti ereditano
# i due valori sopra: decommentare soltanto per usare intervalli differenti.
# DOCKER_TELEGRAF_INTERVAL=30s
# DOCKER_TELEGRAF_FLUSH_INTERVAL=30s

# Prima prova per ridurre il carico: raccolta 60s e invio 30s.
# La dashboard attuale usa una soglia di freschezza di 120s: conservare margine
# per raccolta + attesa invio + rete. Intervalli piu lunghi richiedono di
# rivedere le soglie Grafana. I singoli input locali con interval esplicito
# continuano a usare il proprio valore (ad esempio un vecchio 40-zfs.conf).

# Collector custom: intervallo delle scansioni COSTOSE, non della pubblicazione.
# Accettano interi positivi con suffisso s, m, h. Pubblicazione cache ogni 30s.
IMAGE_CHECK_INTERVAL=6h
DOCKER_PRUNE_INTERVAL=3h

# Si monta soltanto questo file; i sorgenti sono incorporati nell'immagine.
# Per personalizzarlo: cp image-check/settings.json.example image-check/settings.json
# poi impostare IMAGE_CHECK_SETTINGS_FILE=./image-check/settings.json.
# Il file scelto deve esistere ed essere leggibile da UID 65534.
# La copia locale settings.json e ignorata da Git; l'esempio e versionato.
IMAGE_CHECK_SETTINGS_FILE=./image-check/settings.json.example

# ZFS: pool/vdev ogni 60s e dataset ogni 300s, attualmente fissi nel collector.
# I nuovi esempi ARC/kstat ereditano TELEGRAF_INTERVAL; nessun override necessario.
