# Nodometro configuration: copy to .env and customize for this node.
# https://github.com/daelmaselli/nodometro
# Compose project name: nodometro (defined in docker-compose.yml).
# Leave COMPOSE_PROJECT_NAME unset; remove an old value when migrating.

# Prometheus Remote Write destination, also reachable from the bridge network.
# localhost inside a collector refers to the container, not the host.
VICTORIAMETRICS_URL=http://victoriametrics.example:8428/api/v1/write

# Docker socket GID ON THE LOCAL NODE (required by Docker-related profiles):
#   stat -c '%g' /var/run/docker.sock
# Do not copy another node's GID. Leave empty if no Docker-related profile is used.
DOCKER_GID=

# Available profiles: docker, image-check, docker-prune, zfs.
# Empty = standard metrics only; zfs requires working OpenZFS and /dev/zfs.
COMPOSE_PROFILES=docker,image-check,docker-prune

# Directory containing the Compose stacks to inspect for image checks.
COMPOSE_ROOT=/root/docker

# Main Telegraf agent AND Docker collector: durations such as 30s, 60s, 1m.
# Collection: frequency of standard samples, Docker inventory and .prom reads.
# Increasing this interval reduces the number of samples sent to the server.
TELEGRAF_INTERVAL=30s
# Flush: frequency of sending buffered samples to VictoriaMetrics.
# Increasing this interval groups samples without reducing their number;
# large batches may still require multiple HTTP requests.
TELEGRAF_FLUSH_INTERVAL=30s

# Optional overrides for the docker service only. If omitted or empty, they
# inherit the two values above. Uncomment only to use different intervals.
# DOCKER_TELEGRAF_INTERVAL=30s
# DOCKER_TELEGRAF_FLUSH_INTERVAL=30s

# To reduce load, start with collection at 60s and flushing at 30s.
# If dashboards use a 120s freshness threshold, leave room for collection,
# buffering and network delays. Longer intervals require reviewing Grafana
# thresholds. Local inputs with an explicit interval keep their own value
# (for example, an older local copy of 40-zfs.conf).

# Custom collectors: intervals for EXPENSIVE scans, not snapshot publication.
# Positive integers with an s, m or h suffix. Cached results publish every 30s.
IMAGE_CHECK_INTERVAL=6h
DOCKER_PRUNE_INTERVAL=3h

# Only this settings file is mounted; source code is included in the image.
# To customize: cp image-check/settings.json.example image-check/settings.json
# Then set IMAGE_CHECK_SETTINGS_FILE=./image-check/settings.json.
# The selected file must exist and be readable by UID 65534.
# Local settings.json is ignored by Git; the example is versioned.
IMAGE_CHECK_SETTINGS_FILE=./image-check/settings.json.example

# ZFS: pools/vdevs every 60s and datasets every 300s, currently fixed in the collector.
# New ARC/kstat examples inherit TELEGRAF_INTERVAL; no Compose override is needed.
