# Indirizzo comune a tutti i nodi.
VICTORIAMETRICS_URL=http://victoriametrics.example:8428/api/v1/write

# Sul nodo esegui questo comando e inserisci il numero restituito qui sotto:
#   stat -c '%g' /var/run/docker.sock
# Non copiare il numero da un altro nodo: puo essere diverso.
DOCKER_GID=

# Lascia vuoto per le sole metriche di sistema; aggiungi zfs sui nodi OpenZFS.
COMPOSE_PROFILES=docker,image-check,docker-prune
COMPOSE_ROOT=/root/docker
